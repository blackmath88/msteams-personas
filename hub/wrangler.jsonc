// Cloudflare Workers with static assets: the hub is a folder of static files, no Worker code.
// Deploy from this folder with `npx wrangler deploy` after `npm run build`, or connect the
// repository in the Cloudflare dashboard (root directory: hub). See README.md.
{
  "name": "praxis-hub",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  }
}
